// dotfiles-managed-config: zellij-layout
// >>> dotfiles-theme: dotfiles (generated from themes/dotfiles.toml; edit the definition, not this block) >>>
layout {
    tab name="base" focus=true {
        pane
    }

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
              format_left   "{mode} #[fg=#f3f6f9,bold]{tabs}"
              format_center "#[fg=#f3f6f9,bold]{session}"
              format_right  "{command_git_branch} {datetime}"
              format_space  ""

              border_enabled  "false"
              border_char     "─"
              border_format   "#[fg=#8a8fa3]{char}"
              border_position "top"

              mode_normal  "#[bg=#7fb4ca] "
              mode_tmux    "#[bg=#ff8dd7] "

              tab_normal   "#[fg=#8a8fa3]{index}:{name} "
              tab_active   "#[fg=#ffe066,bold,italic]{index}:{name} "

              command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
              command_git_branch_format      "#[fg=#b7cc85] {stdout} "
              command_git_branch_interval    "10"
              command_git_branch_rendermode  "static"

              datetime        "#[fg=#8a8fa3,bold] {format} "
              datetime_format "%A, %d %b %Y %H:%M"
              datetime_timezone "Europe/Berlin"
            }
        }
        children
        pane size=1 borderless=true  {
          plugin location="zellij:status-bar"
        }
    }
}
// <<< dotfiles-theme <<<
