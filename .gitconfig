[user]
	email = alberto.sanchezgomez@telefonica.com
	name = ALBERTO SANCHEZ GOMEZ

# The identity above is the default: it applies everywhere, including personal
# repositories that fall outside the trees listed below. These blocks override
# the address only inside those trees, and git applies the last matching block,
# so the order matters if the trees ever overlap. includeIf does nothing at all
# when the directory is absent, so a machine without it is unaffected.
[includeIf "gitdir:~/my-things/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-personal
[submodule]
	recurse = true
[push]
	recurseSubmodules = check
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	# diff3 rather than zdiff3 on purpose. zdiff3 needs git 2.35 or newer, and an
	# older git does not merely ignore the unknown value: it aborts, so every
	# git command fails, including the clone inside the Oh My Zsh installer.
	# Ubuntu 22.04 LTS ships git 2.34, which makes this a supported platform that
	# the installer would otherwise break outright. Both styles show the common
	# ancestor; zdiff3 only compacts the result.
	conflictstyle = diff3
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
