[user]
	email = alberto.sanchezgomez@telefonica.com
	name = ALBERTO SANCHEZ GOMEZ

# The identity above is the default: it applies everywhere, including personal
# repositories that fall outside the trees listed below. These blocks override
# the address only inside those trees, and git applies the last matching block,
# so the order matters if the trees ever overlap. includeIf does nothing at all
# when the directory is absent, so a machine without it is unaffected.
[includeIf "gitdir:~/my-things/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-personal
[submodule]
	recurse = true
[push]
	recurseSubmodules = check
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
# dotfiles-managed-config: delta
# >>> dotfiles-theme: dotfiles (generated from themes/dotfiles.toml; edit the definition, not this block) >>>
[delta]
	# The syntax highlighting is bat's: delta reads bat's assets, and this is the same
	# .tmTheme file the shell selects BAT_THEME from.
	syntax-theme = dotfiles
	# A changed line is marked by the colour of its text, never by a filled line: a
	# background needs a dim tone these definitions do not hold, and the palette's own
	# green and red as a background leaves the syntax highlighting fighting it.
	minus-style = "#de8fa8"
	minus-emph-style = "bold #de8fa8"
	plus-style = "#d1e8a9"
	plus-emph-style = "bold #d1e8a9"
	file-style = "bold #7fb4ca"
	file-decoration-style = "ul"
	hunk-header-style = "file line-number #ffe066"
	hunk-header-decoration-style = "box"
	line-numbers-left-style = "#8a8fa3"
	line-numbers-right-style = "#8a8fa3"
	line-numbers-minus-style = "#de8fa8"
	line-numbers-plus-style = "#d1e8a9"
	line-numbers-zero-style = "#8a8fa3"
# <<< dotfiles-theme <<<
	navigate = true
[merge]
	# diff3 rather than zdiff3 on purpose. zdiff3 needs git 2.35 or newer, and an
	# older git does not merely ignore the unknown value: it aborts, so every
	# git command fails, including the clone inside the Oh My Zsh installer.
	# Ubuntu 22.04 LTS ships git 2.34, which makes this a supported platform that
	# the installer would otherwise break outright. Both styles show the common
	# ancestor; zdiff3 only compacts the result.
	conflictstyle = diff3
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
